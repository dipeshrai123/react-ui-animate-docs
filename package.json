{
  "name": "react-ui-animate-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "generate:examples": "node scripts/generate-examples-index.js",
    "watch:examples": "npx chokidar 'src/examples/**/*.tsx' --initial -c \"npm run generate:examples\"",
    "start": "concurrently -k \"npm:watch:examples\" \"docusaurus start\"",
    "build": "npm run generate:examples && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@docusaurus/core": "3.0.0",
    "@docusaurus/preset-classic": "3.0.0",
    "@docusaurus/theme-live-codeblock": "^3.0.0",
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "@mdx-js/react": "^3.0.0",
    "@mui/material": "^5.5.3",
    "clsx": "^1.1.1",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.2.1",
    "react-ui-animate": "^5.3.0-next.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.0.0",
    "@docusaurus/types": "3.0.0",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "fs-extra": "^11.3.0",
    "raw-loader": "^4.0.2"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
